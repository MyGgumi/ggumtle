.health-bar-container {
    width: auto;
    display: flex;
    flex-direction: row;
    align-items: center;
    padding: 8px;
}

.health-segment {
    position: relative;
    height: 16px;
    background-color: rgba(20, 20, 20, 0.4);
    border: 3px solid rgba(255, 255, 255, 0.2);
    border-radius: 3px;
    margin-right: 15px;
}

.health-segment-40 {
    width: 120px;
    margin-left: 35px;
}

.health-segment-40-1{
    width: 120px;
}

.health-segment-20 {
    width: 60px;
    background-color: rgba(30, 30, 30, 0.4);
    border-color: rgba(235, 235, 235, 0.2);
}

.health-fill {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    border-radius: 3px;
}

.health-fill-normal {
    background-color: rgba(255, 255, 255, 0.4);
}

.health-fill-shield {
    background-color: rgba(235, 255, 123, 0.4);
}

.hp-icon {
    width: 50px;
    height: 50px;
    background-image: url("project://database/Assets/UI/ToolKit/Sprites/icon_hp.png?fileID=21300000&guid=f9cf82a515e0e4a4884396c74a83a781&type=3#icon_hp");
    background-size: contain;
    position: absolute;
    left: 8px;
    top: 50%;
    translate: 0 -50%;
}

/* 크리티컬 상태 스타일링 */
.critical-state {
    animation-name: critical-pulse;
    animation-duration: 1s;
    animation-iteration-count: infinite;
    animation-timing-function: ease-in-out;
    animation-direction: alternate;
}

.critical-state .health-fill {
    background-color: rgba(220, 20, 20, 0.9) !important;
    box-shadow: 0 0 8px rgba(220, 20, 20, 0.6);
}

.critical-state {
    border-color: rgba(220, 20, 20, 0.8) !important;
    box-shadow: 0 0 12px rgba(220, 20, 20, 0.4);
}

/* 크리티컬 상태 펄스 애니메이션 */
@keyframes critical-pulse {
    0% {
        opacity: 0.8;
        transform: scale(1.0);
    }
    100% {
        opacity: 1.0;
        transform: scale(1.02);
    }
}

/* 체력바 부드러운 변화 애니메이션 */
.health-fill {
    transition: width 0.3s ease-out, background-color 0.2s ease-out;
}

.health-segment {
    transition: border-color 0.2s ease-out, box-shadow 0.2s ease-out;
}

/* 낮은 체력 상태 (30% 이하) */
.low-health .health-fill {
    background-color: rgba(255, 200, 100, 0.6);
}

/* 매우 낮은 체력 상태 (10% 이하) */
.very-low-health .health-fill {
    background-color: rgba(255, 120, 80, 0.7);
}
