/* QuickChat 컴포넌트 전용 스타일 */

.chat-icon-container {
    width: 80px;
    height: 80px;
    background-image: url("project://database/Assets/UI/ToolKit/Sprites/icon_quick-chat.png?fileID=2800000&guid=&type=3#icon_quick-chat");
    background-size: contain;
    margin-right: 20px;
}

.chat-icon {
    width: 80px;
    height: 80px;
    background-size: contain;
}

/* 채팅 상태 표시 */
.chat-notification {
    position: absolute;
    top: -5px;
    right: -5px;
    width: 20px;
    height: 20px;
    background-color: rgba(255, 100, 100, 0.9);
    border-radius: 50%;
    border: 2px solid rgba(255, 255, 255, 0.8);
}

/* 채팅 버튼 호버 효과 */
.chat-icon:hover {
    -unity-background-image-tint-color: rgba(255, 255, 255, 0.8);
    scale: 1.1 1.1;
    transition-duration: 0.2s;
}