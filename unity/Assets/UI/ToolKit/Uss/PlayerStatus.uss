/* PlayerStatus 컴포넌트 전용 스타일 */

/* 꿈틀 원형 진행도 관련 */
.ggumtle-progress {
    position: relative;
    width: 130px;
    height: 130px;
}

.ggumtle-circle-base {
    position: absolute;
    width: 130px;
    height: 130px;
    background-color: rgba(0, 0, 0, 0.4);
    border-radius: 50%;
}

.ggumtle-fill-mask {
    position: absolute;
    left: 0;
    top: 0;
    width: 130px;
    height: 130px;
    border-radius: 50%;
    overflow: hidden;
}

.ggumtle-fill {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(253, 247, 211, 0.2);
}

/* 빛 소지 영역 */
.light-area {
    display: flex;
    flex-direction: row;
    align-items: center;
    align-self: left;
}

.light-icon {
    width: 48px;
    height: 48px;
    background-size: contain;
    margin-left: 10px;
    margin-right: 10px;
}

.light-count {
    color: rgb(255, 255, 255);
    font-size: 32px;
    text-shadow: 1px 1px 0px rgba(0, 0, 0, 0.8);
}