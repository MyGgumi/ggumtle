/* NotificationBanner 컴포넌트 전용 스타일 */

.notification-banner {
    width: 100%;
    height: 80px;
    display: flex;
    align-items: center;
    justify-content: center;
}

.notification-text {
    color: rgb(255, 255, 255);
    font-size: 32px;
    text-shadow: 1px 1px 0px rgba(0, 0, 0, 0.84);
    white-space: nowrap;
}

/* 표시/숨김 상태 */
.hide {
    opacity: 0;
    visibility: hidden;
}

.show {
    opacity: 1;
    visibility: visible;
}

/* 알림 타입별 스타일 */
.notification-success {
    color: rgb(120, 255, 120);
}

.notification-warning {
    color: rgb(255, 255, 120);
}

.notification-error {
    color: rgb(255, 120, 120);
}

.notification-info {
    color: rgb(120, 200, 255);
}

.notification-game {
    color: rgb(180, 180, 255);
}

.notification-player {
    color: rgb(255, 200, 150);
}