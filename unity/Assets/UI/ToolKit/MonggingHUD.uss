/* MonggingHUD.uss */

#hudRoot {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    flex-direction: column;
    -unity-font-definition: url("project://database/Assets/Fonts/SuseongHyejeong.ttf?fileID=12800000&guid=78482f790748c2b4a870af3f386b2fe0&type=3#SuseongHyejeong");
}

#gameInfo {
    position: absolute;
    left: 200px;
    top: 0px;
}

#inventory {
    position: absolute;
    right: 30px;
    top: 340px;
}

#playerList {
    position: absolute;
    right: 30px;
    top: 10px;
}

#playerStatus {
    position: absolute;
    left: 20px;
    top: 0px;
}

#quickChat {
    position: absolute;
    right: 30px;
    top: 200px;
}

#notificationBanner {
    position: absolute;
    left: 0;
    right: 0;
    top: 3%;
}

#healthBar {
    position: absolute;
    left: 30px;
    bottom: 30px;
}

#interactionUI {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 5%;
}

#mobileControls {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    /* UI Builder에서 모바일 컨트롤 위치 조정 시 여기서 수정하세요 */
}