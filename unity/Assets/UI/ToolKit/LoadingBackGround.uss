/* Root Container - 전체 화면 */
.root-container {
    position: absolute;
    width: 100%;
    height: 100%;
    flex-direction: column;
}

/* 배경 컨테이너 */
.background-container {
    position: absolute;
    width: 100%;
    height: 100%;
}

/* 하늘 배경 - 투명 */
.sky-background {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0); /* 완전 투명 */
}


/* 해 이미지 - 상단 중앙 배치 */
.sun-image {
    position: absolute;
    width: 245px;
    height: 245px;
    top: 160px;
    left: 50%;
    translate: -122.5px  0; /* 중앙 정렬 (width의 절반만큼 왼쪽으로) */
    z-index: 10;
}

/* 텍스트 컨테이너 - 중앙 정렬 */
.text-container {
    position: absolute;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    top: 100px;
    z-index: 20;
}

/* 제목 텍스트 */
.title-text {
    font-size: 68px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
    margin-bottom: 10px;
    text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.3);
}

/* 본문 텍스트 */
.body-text {
    font-size: 32px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
    opacity: 0.9;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.3);
}

.sun-image {
    transition-duration: 2s;
    transition-timing-function: ease-in-out;
}

