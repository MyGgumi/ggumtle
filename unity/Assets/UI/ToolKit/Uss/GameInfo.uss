/* GameInfo 컴포넌트 전용 스타일 */

.game-info-container {
    width: auto;
    height: auto;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    align-items: flex-start;
}

.time-display {
    background-color: rgba(0, 0, 0, 0.4);
    border-radius: 8px;
    padding: 2px 15px;
    margin-top: 20px;
    margin-bottom: 12px;
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 160px;
    width: 160px;
}

.time-label {
    color: rgb(200, 200, 200);
    font-size: 20px;
    text-shadow: 1px 1px 0px rgba(0, 0, 0, 0.8);
    text-align: center;
}

.time-value {
    color: rgb(255, 255, 255);
    font-size: 36px;
    text-shadow: 1px 1px 0px rgba(0, 0, 0, 0.8);
    text-align: center;
}

.status-container {
    margin-top: 5px;
    padding: 4px 12px;
    border-radius: 6px;
}

.status-text {
    color: rgb(255, 255, 255);
    font-size: 24px;
    text-shadow: 1px 1px 0px rgba(0, 0, 0, 0.8);
    text-align: center;
    white-space: normal;
}