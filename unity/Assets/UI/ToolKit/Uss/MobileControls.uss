:root {
    --joystick-bg: resource('UI/UI_Circle_Faded');
    --joystick-knob: resource('UI/UI_Circle_Bevel_Base');
    --joystick-icon: resource('UI/UI_Icon_Move');
    --button-bg: resource('UI/UI_Circle_Bevel_Base');
    --jump-icon: resource('UI/UI_Icon_Jump');
    --interact-icon: resource('UI/UI_Icon_Interaction');
}

.mobile-controls-root {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    pointer-events: none;
}

.joystick-area {
    position: absolute;
    left: 30px;
    bottom: 100px;
    width: 400px;
    height: 400px;
    pointer-events: auto;
    picking-mode: position;
    display: flex;
    align-items: center;
    justify-content: center;
}

.joystick-base {
    position: relative;
    width: 100%;
    height: 100%;
}

.joystick-bg {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-image: var(--joystick-bg);
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
    opacity: 0.7;
}

.joystick-knob {
    position: absolute;
    width: 110px;
    height: 110px;
    left: 50%;
    top: 50%;
    margin-left: -55px;
    margin-top: -55px;
    background-image: var(--joystick-knob);
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
    opacity: 0.2;
}

.joystick-icon {
    position: absolute;
    top: 10px;
    left: 10px;
    right: 10px;
    bottom: 10px;
    background-image: var(--joystick-icon);
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
}

.camera-touch-zone {
    position: absolute;
    top: 20%;
    left: 50%;
    right: 0;
    bottom: 0;
    pointer-events: auto;
    picking-mode: position;
    background-color: rgba(0, 0, 0, 0.1);
}

.action-buttons {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 300px;
    height: 300px;
    pointer-events: none;
}

.action-button {
    position: absolute;
    width: 120px;
    height: 120px;
    pointer-events: auto;
    picking-mode: position;
    transition-duration: 0.1s;
    transition-property: scale, opacity;
}

.action-button:hover {
    scale: 1.05 1.05;
}

.action-button:active {
    scale: 0.95 0.95;
    opacity: 0.8;
}

.button-background {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-image: var(--button-bg);
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
    opacity: 0.2;
}

.button-icon {
    position: absolute;
    top: 20px;
    left: 20px;
    right: 20px;
    bottom: 20px;
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
    opacity: 1;
}

.jump-button {
    right: 130px;
    bottom: 60px;
}

.interact-button {
    right: 36px;
    bottom: 186px;
}

.jump-icon {
    background-image: var(--jump-icon);
}

.interact-icon {
    background-image: var(--interact-icon);
}

.debug-touch-zone {
    background-color: rgba(255, 0, 0, 0.1);
    border: 2px dashed rgba(255, 0, 0, 0.3);
}

.debug-joystick {
    background-color: rgba(0, 255, 0, 0.1);
    border: 2px dashed rgba(0, 255, 0, 0.3);
}

.debug-button {
    background-color: rgba(0, 0, 255, 0.1);
    border: 2px dashed rgba(0, 0, 255, 0.3);
}
